# TickTick Open API Token (v1 API)
# Get from: https://developer.ticktick.com/docs#/openapi
DIDA365_TOKEN=Bearer tp_your_token_here

# TickTick Open API URL
DIDA365_API_URL=https://api.ticktick.com/open/v1

# TickTick Session Cookie (v2 API - for focus/pomo features)
# Get from browser F12 -> Network -> Request Headers -> Cookie: t=xxx
COOKIE=your_session_cookie_here
